# Supabase (required for OAuth login/consent pages)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Public app URL (local vs production)
VITE_PUBLIC_APP_URL=http://localhost:8002

# Local dev: copy to frontend/.env.local or set SUPABASE_URL and
# SUPABASE_ANON_KEY in backend/.env / repo root .env.local
